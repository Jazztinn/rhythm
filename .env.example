# Server-only Gemini API key. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash

# Server-only encrypted integration session key. Base64 for exactly 32 random bytes.
INTEGRATION_COOKIE_SECRET=

# Google Calendar OAuth (server-only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Slack OAuth V2 (server-only). Request only channels:read and channels:history.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback
